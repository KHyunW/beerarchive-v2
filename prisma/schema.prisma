generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nickname     String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews Review[]
  posts   Post[]
  likes   Like[]

  @@map("users")
}

model Brewery {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  address     String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beers Beer[]

  @@map("breweries")
}

model Beer {
  id          Int      @id @default(autoincrement())
  name        String
  style       String?
  abv         Float?
  description String?  @db.Text
  imageUrl    String?
  breweryId   Int
  brewery     Brewery  @relation(fields: [breweryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews Review[]

  likes   Like[]

  @@index([breweryId])
  @@map("beers")
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  content   String?  @db.Text
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beerId    Int
  beer      Beer     @relation(fields: [beerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, beerId])
  @@index([beerId])
  @@map("reviews")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes     Like[]

  @@index([userId])
  @@map("posts")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  beerId    Int?
  beer      Beer?    @relation(fields: [beerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, beerId])
  @@map("likes")
}
